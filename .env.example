# Copy to .env and export, or set in your shell. All optional in mock mode.
AIRLOCK_MODE=mock                 # mock | docker
AIRLOCK_PROTECT=1                 # 0 = unprotected baseline for the demo contrast
AIRLOCK_AUTONOMY=balanced         # supervised | balanced | autonomous
AIRLOCK_KEY_PORT=                 # e.g. /dev/ttyACM0 or COM5 to enable the hardware key
AIRLOCK_KEY_SECRET=dev-secret-change-me   # must equal SHARED_SECRET in firmware/src/config.h
AIRLOCK_APPROVAL_TIMEOUT=60
AIRLOCK_ALLOWLIST=demo.local,localhost,example.com
AIRLOCK_AGENT=scripted            # scripted | llm (default agent for POST /tasks)
ANTHROPIC_API_KEY=                # only for AIRLOCK_AGENT=llm; set in your shell, never commit
AIRLOCK_AGENT_MODEL=claude-sonnet-5-5
AIRLOCK_STANDING=                 # standing tasks: empty = off (default) | 1 = on (a scheduler runs recurring errands; unattended approvals are denied on timeout)
AIRLOCK_STANDING_AGENT=scripted   # scripted (no key, no cost) | llm (a real model; UNTESTED). Caps: AIRLOCK_STANDING_MAX_PER_DAY, _DAILY_CAP, _MAX_STEPS, _TOKEN_BUDGET, _RUN_TIMEOUT
AIRLOCK_TINYFISH=                 # web_task: empty = off (default) | 1 = real TinyFish (needs TINYFISH_API_KEY in your shell) | mock = canned results, mock mode only
# TINYFISH_API_KEY: set in your shell (source ~/.airlock-env), never here and never committed
AIRLOCK_AGENT_MAX_STEPS=15
AIRLOCK_AGENT_MAX_TOKENS=1024
AIRLOCK_AGENT_TIMEOUT=120         # wall-clock seconds for one LLM task
