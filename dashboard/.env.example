# Optional Auth0 login for the dashboard. Leave unset for no login (the default).
# Both domain and client id must be set to turn it on. Restart `npm run dev` after changing. See docs/AUTH0.md.
VITE_AUTH0_DOMAIN=            # e.g. your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=          # must equal AUTH0_AUDIENCE on the gateway
